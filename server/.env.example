PORT=5000
CLIENT_URL=http://localhost:5173
# Set to the exact number of trusted reverse-proxy hops in production; leave empty for direct connections.
TRUST_PROXY_HOPS=
MONGO_URI=mongodb://127.0.0.1:27017/zentro?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bank transfer is enabled when bank name, account name, and account number are set.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_BRANCH=
